rules_version = '2';

// Coltek Academy — Firestore security rules.
//
// Browsers (Firebase client SDK) are bound by these rules. Server code that needs
// private data (enrollment counts, statistics, certificate API routes, uploads)
// uses Firebase Admin, which is not bound by them.
//
// An admin is a signed-in user with ANY of:
//   users/{uid}.role == 'admin', adminUsers/{uid}.role == 'admin', or the `admin` custom claim.
// Admins are provisioned only with scripts/create-admin-user.ts (Firebase Admin) —
// no browser can grant itself the admin role.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function hasAdminRole(collectionName) {
      let path = /databases/$(database)/documents/$(collectionName)/$(request.auth.uid);
      return exists(path) && get(path).data.get('role', '') == 'admin';
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.get('admin', false) == true ||
        hasAdminRole('users') ||
        hasAdminRole('adminUsers')
      );
    }

    // Admins can read and write everything (admin dashboard, certificates, users, courses…)
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Public course catalogue
    match /courses/{courseId} {
      allow read: if true;
    }

    // Published testimonials and student projects are public (queries must filter isPublished == true)
    match /testimonials/{testimonialId} {
      allow read: if resource.data.isPublished == true;
    }
    match /projects/{projectId} {
      allow read: if resource.data.isPublished == true;
    }

    // Student profiles: each student reads and maintains their own, but can never change their role
    match /users/{userId} {
      allow read: if isSelf(userId);
      allow create: if isSelf(userId)
        && request.resource.data.get('role', 'student') == 'student';
      allow update: if isSelf(userId)
        && request.resource.data.get('role', 'student') == resource.data.get('role', 'student');
    }

    // Admin markers: a user may check their own; only admins (or Firebase Admin) write them
    match /adminUsers/{userId} {
      allow read: if isSelf(userId);
    }

    // Enrollments: a student creates and reads only their own
    match /enrollments/{enrollmentId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'active';
    }

    // Certificates: a student reads only their own (missing documents read as "not found")
    match /certificates/{certificateId} {
      allow read: if signedIn() && (resource == null || resource.data.userId == request.auth.uid);
    }

    // certificateFiles (+ chunks) and activities: admins and Firebase Admin only (covered above)
    // Everything else is denied by default.
  }
}
